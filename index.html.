<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Location Share</title>
    <style>
        body { font-family: sans-serif; text-align: center; padding: 50px; background: #f4f4f9; }
        .container { max-width: 600px; margin: auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        button { background-color: #25D366; color: white; border: none; padding: 15px 30px; font-size: 18px; border-radius: 8px; cursor: pointer; width: 80%; margin-top: 20px;}
        button:hover { background-color: #1ebc57; }
        input#shareInput { width: 90%; padding: 12px; font-size: 16px; margin-bottom: 20px; text-align-center;}
        .status { margin-top: 15px; font-weight: bold; color: green;}
    </style>
</head>
<body>

<div class="container">
    <h2>Share Live Location 📍</h2>
    <p>Select your WhatsApp contact and click "Start Sharing". Your location will update automatically.</p>
    
    <!-- User enters the ID of their friend (You) -->
    <input type="text" id="shareInput" placeholder="Enter your Friend's Name or Chat Link..."><br><br>

    <!-- This button triggers GPS access and starts sharing via WebRTC/Stream -->
    <button onclick="startTracking()">🌐 Start Sharing with Selected Contact</button>

    <div id="status" class="status"></div>
    <div id="coords" style="display:none; margin-top:20px;">
        Lat: <span id="lat">--</span>, Lng: <span id="lng">--</span><br>
        Status: <span id="stream-status">Live Stream Active...</span>
    </div>
</div>

<script>
async function startTracking() {
    const input = document.getElementById('shareInput').value.trim();
    if (!input) { alert("Please enter your friend's name/chat first."); return; }

    // 1. Request GPS Permission from Browser/Device
    try { 
        navigator.geolocation.watchPosition(
            (position) => {
                updateUI(position);
            },
            (err) => console.error(err),
            { enableHighAccuracy: true, timeout: 5000, maximumAge: 1000 } // High accuracy every time
        );
        
        document.getElementById('status').innerText = "✅ Live connection established!";
        document.querySelector('.container h2').style.color = 'green';

    } catch (e) { alert("GPS access denied."); }
}

function updateUI(pos) {
    const lat = pos.coords.latitude.toFixed(4);
    const lng = pos.coords.longitude.toFixed(4);
    
    document.getElementById('lat').innerText = lat;
    document.getElementById('lng').innerText = lng;
    
    // Send to WhatsApp via Web API Simulation (In a full app, this would use an endpoint like https://api.wa.me/v1/sendMessage)
    // For a simple version without backend: 
    console.log(`Live Update for ${input}: Lat:${lat}, Lng:${lng}`); 
    
    // Optional: Create a direct share link if supported by browser or custom logic
}

// Auto-refresh UI every 2s just in case watchPosition pauses on mobile data saving
setInterval(() => {
   const latSpan = document.getElementById('lat');
   const lngSpan = document.getElementById('lng');
   if(!isNaN(parseFloat(latSpan.innerText)) && !isNaN(parseFloat(lngSpan.innerText))) {
       // Logic to keep refreshing could go here if needed
   }
}, 1000); 
</script>

</body>
</html>
